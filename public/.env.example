# ARIKARTECH Public Frontend Environment Configuration
# Used during static build ('npm run build' / 'npm run export')

# Production site URL
NEXT_PUBLIC_SITE_URL=https://arikartech.com

# Laravel 11 REST API Base URL (called client-side from browser)
NEXT_PUBLIC_API_URL=https://api.arikartech.com/api/v1

# Analytics & Verification (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION_CODE=
