# ARIKARTECH Environment Configuration Template
# PRODUCTION NOTE: Never commit real credentials or production keys.

# Application Environment
APP_NAME=ARIKARTECH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://arikartech.com
ADMIN_URL=https://admin.arikartech.com
API_URL=https://api.arikartech.com

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=info

# Database (MySQL production / SQLite for testing)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arikartech_prod
DB_USERNAME=arikartech_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Cache, Session & Queue (Filesystem/DB for shared-hosting stability)
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mail.arikartech.com
MAIL_PORT=587
MAIL_USERNAME=noreply@arikartech.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@arikartech.com"
MAIL_FROM_NAME="ARIKARTECH"

# File Storage
FILESYSTEM_DISK=local

# Production Administrator Bootstrap (Optional overrides for php artisan admin:seed)
ARIKARTECH_ADMIN_NAME="Admin User"
ARIKARTECH_ADMIN_EMAIL="admin@arikartech.com"
ARIKARTECH_ADMIN_PASSWORD=

# Affiliate Networks (Configure when active - Empty by default)
# 1. Awin Network (UK, DE, FR, IT, ES, NL)
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# 2. CJ Affiliate (US, UK, EU, AU, NZ)
CJ_API_TOKEN=
CJ_COMPANY_ID=
CJ_WEBSITE_ID=

# 3. Impact.com (US, UK, DE, AU)
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_MEDIA_PARTNER_ID=

# 4. Amazon Associates (DEFERRED / NOT ELIGIBLE - Leave empty)
AMAZON_ASSOCIATES_TAG_US=arikartech-20
AMAZON_ASSOCIATES_TAG_UK=
AMAZON_ASSOCIATES_TAG_DE=
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_PAAPI_REGION=us-east-1

# CPU-Safe Automation Limits
AUTOMATION_MAX_ITEMS_PER_RUN=100
AUTOMATION_MAX_RUNTIME_SECONDS=240
AUTOMATION_MAX_API_REQUESTS_PER_RUN=50
AUTOMATION_MAX_RETRIES=3
AUTOMATION_CHUNK_SIZE=25

# Public Frontend & Analytics
NEXT_PUBLIC_SITE_URL=https://arikartech.com
NEXT_PUBLIC_API_URL=https://api.arikartech.com/api/v1
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION_CODE=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.arikartech.com/api/v1/auth/google/callback
